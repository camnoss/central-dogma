{
  "type": "record",
  "name": "CustomerBillState",
  "namespace": "com.company.billing.customerbill",
  "doc": "Event-carried state transfer snapshot of a finalized customer bill owned by the Billing domain (Oracle BRM). One record per committed change, keyed by billId. Consumers upsert by billId only when stateVersion is greater than the stored one.",
  "fields": [
    { "name": "billId", "type": "string",
      "doc": "Stable public id of the bill: object id of the BRM /bill POID, without database number or revision. Also the Kafka key, CloudEvents subject and partitionkey." },
    { "name": "billNumber", "type": "string",
      "doc": "Customer-visible bill number. Used as payment reference by banks and channels." },
    { "name": "billingAccountId", "type": "string",
      "doc": "Customer-visible number of the paying account. Pseudonymous personal identifier." },
    { "name": "state",
      "type": { "type": "enum", "name": "CustomerBillLifecycleState",
        "symbols": ["UNKNOWN", "NEW", "VALIDATED", "SENT", "PARTIALLY_PAID", "SETTLED"],
        "default": "UNKNOWN",
        "doc": "Aligned with BRM bill-level states and TMF678. Unknown symbols resolve to UNKNOWN." } },
    { "name": "currency", "type": "string",
      "doc": "ISO 4217 alphabetic code, e.g. COP. Translated from the BRM numeric currency code." },
    { "name": "billDate", "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "Instant when the bill was finalized." },
    { "name": "paymentDueDate", "type": { "type": "int", "logicalType": "date" },
      "doc": "Payment due date as a calendar date in America/Bogota." },
    { "name": "billingPeriod",
      "type": { "type": "record", "name": "BillingPeriod", "fields": [
        { "name": "start", "type": { "type": "long", "logicalType": "timestamp-millis" } },
        { "name": "end", "type": { "type": "long", "logicalType": "timestamp-millis" } } ] } },
    { "name": "amounts",
      "doc": "Amounts in the bill currency as non-negative magnitudes; BRM sign conventions are normalized by the projector.",
      "type": { "type": "record", "name": "BillAmounts", "fields": [
        { "name": "remainingAmount",
          "type": { "type": "fixed", "name": "Amount", "size": 8, "logicalType": "decimal", "precision": 18, "scale": 2 },
          "doc": "Outstanding balance of this bill." },
        { "name": "totalDue", "type": "Amount", "doc": "Total due at finalization, including previous balance." },
        { "name": "previousBalance", "type": "Amount" },
        { "name": "currentCharges", "type": "Amount", "doc": "Charges of this billing period." },
        { "name": "paymentsReceived", "type": "Amount" },
        { "name": "adjusted", "type": "Amount" },
        { "name": "disputed", "type": "Amount", "doc": "Amount under open disputes." },
        { "name": "transferred", "type": "Amount" },
        { "name": "writtenOff", "type": "Amount" } ] } },
    { "name": "invoice",
      "type": ["null", { "type": "record", "name": "InvoiceRef", "fields": [
        { "name": "invoiceId", "type": "string" },
        { "name": "issuedAt", "type": { "type": "long", "logicalType": "timestamp-millis" } } ] }],
      "default": null,
      "doc": "Reference to the invoice document; null until it is generated." },
    { "name": "stateVersion", "type": "long",
      "doc": "Monotonic version of this bill state (revision of the BRM /bill object). Readers must ignore records whose stateVersion is not greater than the stored one." },
    { "name": "lastModifiedAt", "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "Instant of the last committed change in BRM." }
  ]
}
